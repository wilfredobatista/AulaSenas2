{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aulasenas2.local/contracts/landmark-point.schema.json",
  "title": "Punto de landmark",
  "description": "Forma observada en la referencia de visión. La disponibilidad y semántica de cada coordenada dependen del extractor externo.",
  "type": "object",
  "properties": {
    "x": { "type": "number" },
    "y": { "type": "number" },
    "z": { "type": "number" },
    "visibility": { "type": "number" }
  },
  "additionalProperties": true,
  "minProperties": 1
}
