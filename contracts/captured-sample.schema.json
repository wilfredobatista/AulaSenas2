{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aulasenas2.local/contracts/captured-sample.schema.json",
  "title": "Muestra AulaSenas2-Lite",
  "description": "Secuencia temporal Lite de longitud real y variable. Las invariantes entre frames se validan junto al schema para impedir interpolación, padding o cronologías falsas.",
  "type": "object",
  "required": ["featureContract", "classId", "fuente", "tiempo", "frames", "capturedAt"],
  "properties": {
    "featureContract": { "const": "AULASENAS2_LITE_F139_V1" },
    "id": { "type": "string", "minLength": 1 },
    "classId": { "oneOf": [{ "$ref": "sign-class.schema.json#/$defs/classIdNormal" }, { "const": "ruido_background" }] },
    "fuente": { "$ref": "sample-source.schema.json" },
    "tiempo": { "$ref": "sample-time.schema.json" },
    "frames": { "type": "array", "minItems": 1, "items": { "$ref": "frame.schema.json" } },
    "capturedAt": { "type": "string", "format": "date-time" },
    "stage": { "const": "validated" }
  },
  "additionalProperties": false
}
